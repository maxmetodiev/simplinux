#!/bin/bash

# Best practice: Use an absolute path so the script works from anywhere
TARGET_DIR="$HOME/simplinux"

# 1. Check if the directory exists
if [ -d "$TARGET_DIR" ]; then
    
    # 2. Check if it's actually a git repository
    if [ -d "$TARGET_DIR/.git" ]; then
        
        echo "Updating simplinux..."
        # 3. Change into the directory and pull
        cd "$TARGET_DIR" && git pull
        
    else
        echo "Error: $TARGET_DIR exists but is not a Git repository."
    fi
else
    echo "Error: Directory $TARGET_DIR not found."
fi

